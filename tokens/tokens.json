{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Jo's Design System - machine-readable mirror of tokens.css. Keep in sync.",

  "font": {
    "en":   { "value": "'Lora', Georgia, 'Times New Roman', serif", "type": "fontFamily" },
    "ar":   { "value": "'Noto Naskh Arabic', 'Traditional Arabic', serif", "type": "fontFamily" },
    "mono": { "value": "'SF Mono', Menlo, Consolas, monospace", "type": "fontFamily" }
  },

  "fontSize": {
    "xs":   { "value": "0.75rem",  "type": "dimension", "comment": "12px - metadata, unit labels" },
    "sm":   { "value": "0.875rem", "type": "dimension", "comment": "14px - body in compact surfaces" },
    "base": { "value": "1rem",     "type": "dimension", "comment": "16px - default body" },
    "lg":   { "value": "1.125rem", "type": "dimension", "comment": "18px - sub-titles" },
    "xl":   { "value": "1.25rem",  "type": "dimension", "comment": "20px - card titles" },
    "2xl":  { "value": "1.5rem",   "type": "dimension", "comment": "24px - hero h2" },
    "3xl":  { "value": "1.875rem", "type": "dimension", "comment": "30px - page headers" },
    "4xl":  { "value": "2.25rem",  "type": "dimension", "comment": "36px - display" },
    "5xl":  { "value": "3rem",     "type": "dimension", "comment": "48px - presentation mode" }
  },

  "fontWeight": {
    "regular":    { "value": 400, "type": "fontWeight" },
    "medium":     { "value": 500, "type": "fontWeight" },
    "semibold":   { "value": 600, "type": "fontWeight" },
    "bold":       { "value": 700, "type": "fontWeight" },
    "extrabold":  { "value": 800, "type": "fontWeight" }
  },

  "lineHeight": {
    "tight":    { "value": 1.25, "type": "number" },
    "snug":     { "value": 1.4,  "type": "number" },
    "normal":   { "value": 1.6,  "type": "number" },
    "relaxed":  { "value": 1.75, "type": "number" }
  },

  "letterSpacing": {
    "tight":   { "value": "-0.02em", "type": "dimension" },
    "normal":  { "value": "0",       "type": "dimension" },
    "wide":    { "value": "0.08em",  "type": "dimension" },
    "wider":   { "value": "0.12em",  "type": "dimension", "comment": "uppercase section labels" },
    "widest":  { "value": "0.15em",  "type": "dimension", "comment": "dropdown section headers" }
  },

  "color": {
    "gray": {
      "50":  { "value": "#f8fafc", "type": "color" },
      "100": { "value": "#f1f5f9", "type": "color" },
      "200": { "value": "#e2e8f0", "type": "color" },
      "300": { "value": "#cbd5e1", "type": "color" },
      "400": { "value": "#94a3b8", "type": "color" },
      "500": { "value": "#64748b", "type": "color" },
      "600": { "value": "#475569", "type": "color" },
      "700": { "value": "#334155", "type": "color" },
      "800": { "value": "#1e293b", "type": "color" },
      "900": { "value": "#0f172a", "type": "color" }
    },

    "readiness": {
      "from":     { "value": "#78350f", "type": "color", "comment": "amber-900" },
      "to":       { "value": "#fbbf24", "type": "color", "comment": "amber-400" },
      "gradient": { "value": "linear-gradient(90deg, #78350f 0%, #fbbf24 100%)", "type": "gradient" }
    },

    "domain": {
      "ld":  { "primary": "#1e3a5f", "light": "#e8f4fc", "accent": "#3498db", "gradient": "linear-gradient(135deg, #1e3a5f 0%, #2d5a8a 100%)", "comment": "Leadership - navy" },
      "pc":  { "primary": "#0f766e", "light": "#f0fdfa", "accent": "#2dd4bf", "gradient": "linear-gradient(135deg, #0f766e 0%, #14b8a6 100%)", "comment": "Patient Care - teal" },
      "mis": { "primary": "#6b21a8", "light": "#faf5ff", "accent": "#c084fc", "gradient": "linear-gradient(135deg, #6b21a8 0%, #9333ea 100%)", "comment": "Medical Information - purple" },
      "lb":  { "primary": "#b45309", "light": "#fffbeb", "accent": "#fbbf24", "gradient": "linear-gradient(135deg, #b45309 0%, #d97706 100%)", "comment": "Laboratory - amber" },
      "mm":  { "primary": "#991b1b", "light": "#fef2f2", "accent": "#f87171", "gradient": "linear-gradient(135deg, #991b1b 0%, #dc2626 100%)", "comment": "Medication Management - crimson" },
      "moi": { "primary": "#166534", "light": "#f0fdf4", "accent": "#4ade80", "gradient": "linear-gradient(135deg, #166534 0%, #16a34a 100%)", "comment": "Mother/Infant - forest" },
      "ipc": { "primary": "#312e81", "light": "#eef2ff", "accent": "#818cf8", "gradient": "linear-gradient(135deg, #312e81 0%, #4f46e5 100%)", "comment": "Infection Prevention - indigo" },
      "fms": { "primary": "#9a3412", "light": "#fff7ed", "accent": "#fb923c", "gradient": "linear-gradient(135deg, #9a3412 0%, #ea580c 100%)", "comment": "Facility/Safety - orange" }
    },

    "score": {
      "met":       { "fg": "#10b981", "bg": "#ecfdf5", "comment": "85%+ or fully met" },
      "partial":   { "fg": "#f59e0b", "bg": "#fffbeb", "comment": "60-84% or partially met" },
      "notMet":    { "fg": "#ef4444", "bg": "#fef2f2", "comment": "<60% or not met" },
      "na":        { "fg": "#94a3b8", "bg": "#f8fafc", "comment": "N/A or unknown" }
    },

    "glass": {
      "bg":     { "value": "rgba(255, 255, 255, 0.85)", "type": "color" },
      "bgLo":   { "value": "rgba(255, 255, 255, 0.80)", "type": "color", "comment": "over complex backdrop" },
      "bgHi":   { "value": "rgba(255, 255, 255, 0.92)", "type": "color", "comment": "over plain backdrop" },
      "border": { "value": "1px solid rgba(255, 255, 255, 0.70)", "type": "border" },
      "blur":   { "value": "blur(20px)", "type": "filter" },
      "shadow": { "value": "0 2px 12px rgba(0, 0, 0, 0.03)", "type": "shadow" }
    },

    "onGradient": {
      "surface":   { "value": "rgba(255, 255, 255, 0.22)", "type": "color" },
      "surface2":  { "value": "rgba(255, 255, 255, 0.15)", "type": "color" },
      "border":    { "value": "1px solid rgba(255, 255, 255, 0.40)", "type": "border" }
    },

    "hero": {
      "base":    { "value": "#1a2332", "type": "color", "comment": "mid anchor - composed into layered radials, not a solid fill" },
      "deep":    { "value": "#0f1822", "type": "color", "comment": "outer vignette at 78%/92%" },
      "glow":    { "value": "#2d3f56", "type": "color", "comment": "inner lift at 22%/18%" },
      "ink":     { "value": "#f4ede0", "type": "color", "comment": "primary on-hero text, warm off-white" },
      "inkSoft": { "value": "rgba(244, 237, 224, 0.62)", "type": "color", "comment": "secondary on-hero metadata" }
    }
  },

  "spacing": {
    "1":  { "value": "0.25rem", "type": "dimension", "comment":  "4px - icon-to-label" },
    "2":  { "value": "0.5rem",  "type": "dimension", "comment":  "8px - within a component" },
    "3":  { "value": "0.75rem", "type": "dimension", "comment": "12px - default component gap" },
    "4":  { "value": "1rem",    "type": "dimension", "comment": "16px - between tightly-related items" },
    "5":  { "value": "1.25rem", "type": "dimension", "comment": "20px - card padding, tile gap" },
    "6":  { "value": "1.5rem",  "type": "dimension", "comment": "24px - section padding" },
    "7":  { "value": "1.75rem", "type": "dimension", "comment": "28px - card padding (large)" },
    "8":  { "value": "2rem",    "type": "dimension", "comment": "32px - hero band padding" },
    "10": { "value": "2.5rem",  "type": "dimension", "comment": "40px - between sections" },
    "12": { "value": "3rem",    "type": "dimension", "comment": "48px - page top" }
  },

  "radius": {
    "sm":   { "value": "0.5rem",    "type": "dimension", "comment":  "8px - badge, pill" },
    "md":   { "value": "0.75rem",   "type": "dimension", "comment": "12px - chip, button" },
    "lg":   { "value": "1.125rem",  "type": "dimension", "comment": "18px - tile" },
    "xl":   { "value": "1.375rem",  "type": "dimension", "comment": "22px - card" },
    "2xl":  { "value": "1.5rem",    "type": "dimension", "comment": "24px - hero band" },
    "full": { "value": "9999px",    "type": "dimension", "comment":       "pill, progress bar" }
  },

  "shadow": {
    "card":       { "value": "0 2px 12px rgba(0, 0, 0, 0.03)", "type": "shadow" },
    "cardHover":  { "value": "0 8px 24px rgba(0, 0, 0, 0.08)", "type": "shadow" },
    "dropdown":   { "value": "0 25px 60px rgba(0, 0, 0, 0.20), 0 8px 24px rgba(0, 0, 0, 0.10)", "type": "shadow" }
  },

  "motion": {
    "easeOut":          { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "type": "cubicBezier" },
    "durationFast":     { "value": "180ms", "type": "duration" },
    "durationSlow":     { "value": "700ms", "type": "duration" },
    "transitionState":  { "value": "all 180ms cubic-bezier(0.16, 1, 0.3, 1)", "type": "transition" },
    "transitionProgress": { "value": "width 700ms cubic-bezier(0.16, 1, 0.3, 1)", "type": "transition" }
  },

  "zIndex": {
    "base":     { "value": 0,    "type": "number" },
    "card":     { "value": 1,    "type": "number" },
    "sticky":   { "value": 100,  "type": "number" },
    "dropdown": { "value": 1000, "type": "number" },
    "overlay":  { "value": 1500, "type": "number" },
    "capsule":  { "value": 2000, "type": "number" },
    "modal":    { "value": 3000, "type": "number" },
    "toast":    { "value": 4000, "type": "number" }
  }
}
